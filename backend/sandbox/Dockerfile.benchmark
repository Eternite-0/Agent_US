FROM node:24-alpine

RUN apk add --no-cache git

ENV HOME=/tmp \
    TMPDIR=/tmp \
    TMP=/tmp \
    TEMP=/tmp \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    NODE_ENV=test \
    CI=true \
    NPM_CONFIG_OFFLINE=true \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_IGNORE_SCRIPTS=true \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    GIT_TERMINAL_PROMPT=0 \
    GIT_CONFIG_NOSYSTEM=1 \
    NO_PROXY=*

WORKDIR /work
USER 65534:65534

{
  "name": "@agent-us/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "node server.mjs",
    "check": "tsc --noEmit",
    "test:e2e": "node test/e2e/run.mjs fixture",
    "test:e2e:direct": "node test/e2e/run.mjs direct",
    "test:e2e:runtime": "playwright test --config test/browser-runtime/playwright.config.mjs",
    "test:e2e:visual": "playwright test --config test/thread-visual/playwright.config.mjs"
  },
  "dependencies": {
    "agent-us": "file:..",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
